{
  "name": "tsight",
  "version": "1.0.0",
  "description": "TSight - TypeScript Code Analyzer with Mental Model Visualization",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "concurrently \"npm run dev --workspace=@tsight/api\" \"npm run dev --workspace=@tsight/web\"",
    "start": "npm run start --workspace=@tsight/api"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "typescript": "^5.3.0"
  }
}
