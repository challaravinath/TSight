{
  "name": "@tsight/api",
  "version": "3.0.2",
  "description": "TSight server: serves the web UI and runs the analysis in a worker thread",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && concurrently -k \"tsc --watch --preserveWatchOutput\" \"node --watch dist/index.js\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tsight/core": "^3.0.2",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "simple-git": "^3.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.15",
    "typescript": "^5.3.0"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "license": "MIT",
  "homepage": "https://github.com/challaravinath/TSight#readme",
  "bugs": {
    "url": "https://github.com/challaravinath/TSight/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/challaravinath/TSight.git",
    "directory": "packages/api"
  },
  "keywords": [
    "typescript",
    "javascript",
    "static-analysis",
    "code-analysis",
    "dependency-graph",
    "git",
    "codebase",
    "complexity"
  ],
  "publishConfig": {
    "access": "public"
  }
}
