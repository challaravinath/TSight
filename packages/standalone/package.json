{
  "name": "@tsight/standalone",
  "version": "1.0.0",
  "description": "TSight standalone executable",
  "main": "dist/server.js",
  "type": "module",
  "bin": {
    "tsight": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "package:win": "pkg dist/server.js --targets node18-win-x64 --output dist/tsight-win.exe --assets ../web/dist/**/*",
    "package:mac": "pkg dist/server.js --targets node18-macos-x64 --output dist/tsight-mac",
    "package:linux": "pkg dist/server.js --targets node18-linux-x64 --output dist/tsight-linux"
  },
  "pkg": {
    "assets": [
      "../web/dist/**/*"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "@tsight/core": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2"
  }
}
