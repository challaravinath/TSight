{
  "name": "tsight",
  "version": "3.0.0",
  "description": "Understand any TypeScript codebase in 30 seconds. No AI. No guessing. Just facts from your code.",
  "type": "module",
  "bin": {
    "tsight": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-web.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tsight/api": "*",
    "@tsight/core": "*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/challaravinath/TSight"
  }
}
