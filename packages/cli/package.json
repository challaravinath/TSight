{
  "name": "tsight",
  "version": "3.0.1",
  "description": "Understand any TypeScript codebase in 30 seconds. No AI. No guessing. Just facts from your code.",
  "type": "module",
  "bin": {
    "tsight": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-web.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tsight/api": "^3.0.1",
    "@tsight/core": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/challaravinath/TSight.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/challaravinath/TSight#readme",
  "bugs": {
    "url": "https://github.com/challaravinath/TSight/issues"
  },
  "keywords": [
    "typescript",
    "javascript",
    "static-analysis",
    "code-analysis",
    "dependency-graph",
    "git",
    "codebase",
    "complexity",
    "cli",
    "github-action",
    "code-review"
  ]
}
